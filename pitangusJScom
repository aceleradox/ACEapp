<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pitangus JS Shell Socket</title>

  <!-- Engine Pitangus.js -->
  <script src="https://cdn.jsdelivr.net/gh/aceleradox/Pitangus.js@v2.0.0/pitangus.js"></script>

  <!-- Socket.IO -->
  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #0a0a0a;
      color: #c0c0c0;
      font-family: 'Courier New', Courier, monospace;
      height: 100vh;
      display: flex;
      overflow: hidden;
    }

    /* ---------- SIDEBAR (MENU) ---------- */
    #sidebar {
      width: 260px;
      flex-shrink: 0;
      background-color: #111;
      border-right: 2px solid #333;
      display: flex;
      flex-direction: column;
      padding: 16px 8px;
    }

    #sidebar h1 {
      color: #ffcc00;
      font-size: 18px;
      text-align: center;
      margin-bottom: 20px;
      letter-spacing: 2px;
      border-bottom: 1px dashed #ffcc00;
      padding-bottom: 8px;
    }

    #menu {
      list-style: none;
      flex: 1;
      overflow-y: auto;
    }

    #menu li {
      padding: 10px 14px;
      margin-bottom: 4px;
      cursor: pointer;
      border-left: 4px solid transparent;
      transition: background 0.15s, border-color 0.15s;
      font-size: 14px;
      user-select: none;
    }

    #menu li:hover {
      background-color: #1a1a1a;
    }

    #menu li.selected {
      background-color: #222;
      border-left-color: #ffcc00;
      color: #ffcc00;
      font-weight: bold;
    }

    #sidebar .hint {
      font-size: 11px;
      color: #666;
      text-align: center;
      padding-top: 12px;
      border-top: 1px dashed #333;
      margin-top: auto;
    }

    /* ---------- ÁREA DE CONTEÚDO ---------- */
    #content {
      flex: 1;
      min-width: 0;
      padding: 24px 32px;
      overflow-y: auto;
    }

    #content h2 {
      color: #ffcc00;
      font-size: 20px;
      margin-bottom: 16px;
      border-bottom: 1px solid #333;
      padding-bottom: 6px;
    }

    #content p {
      margin-bottom: 12px;
      line-height: 1.5;
    }

    #content input,
    #content button,
    #content textarea {
      background-color: #1a1a1a;
      border: 1px solid #444;
      color: #c0c0c0;
      padding: 8px 12px;
      font-family: inherit;
      font-size: 14px;
      margin-right: 8px;
      margin-bottom: 8px;
      border-radius: 2px;
    }

    #content input:focus,
    #content textarea:focus {
      outline: 1px solid #ffcc00;
    }

    #content button {
      background-color: #222;
      cursor: pointer;
      border-color: #555;
    }

    #content button:hover {
      background-color: #333;
      border-color: #ffcc00;
    }

    #content button:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    #content pre {
      background-color: #111;
      border: 1px solid #333;
      padding: 14px;
      overflow-x: auto;
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 16px;
      white-space: pre-wrap;
    }

    #content .log {
      background-color: #000;
      border: 1px solid #333;
      padding: 10px;
      font-size: 13px;
      max-height: 200px;
      overflow-y: auto;
      margin-top: 12px;
      white-space: pre-wrap;
    }

    #content .log .error {
      color: #ff5555;
    }

    #content .log .ok {
      color: #55ff55;
    }

    /* ---------- CANVAS DO JOGO (OCULTO ATÉ CONECTAR) ---------- */
    #game-wrapper {
      display: none;
      margin-top: 16px;
      border: 2px solid #00e5ff;
      background: #0a0a0a;
      width: fit-content;
      max-width: 100%;
      box-shadow: 0 0 30px rgba(0, 229, 255, 0.15);
    }

    #game-wrapper.connected {
      display: block;
    }

    #game-container canvas {
      display: block;
      max-width: 100%;
      height: auto;
    }
  </style>
</head>
<body>

  <!-- ========== SIDEBAR ========== -->
  <aside id="sidebar">
    <h1>PITANGUS<br>SHELL</h1>
    <ul id="menu"></ul>
    <div class="hint">↑ ↓ para navegar<br>Enter para selecionar</div>
  </aside>

  <!-- ========== CONTEÚDO ========== -->
  <main id="content"></main>

  <script>
    // ============================================================
    // 1. DEFINIÇÃO DAS OPÇÕES DO MENU
    // ============================================================
    const MENU_ITEMS = [
      { id: 'socket-play',      label: '🔌 Socket Play (WebSocket)' },
      { id: 'socket-io',        label: '📡 Socket.IO (Servidor)' },
      { id: 'irc-chat',         label: '💬 IRC Chat (WebSocket)' },
      { id: 'stream',           label: '🎮 Stream (2 Players)' },
      { id: 'manual',           label: '📖 Manual (Node.js)' },
      { id: 'pitangus-request', label: '📨 Pitangus Request' },
      { id: 'pitangus-party',   label: '🎉 Pitangus Party' },
      { id: 'pitangus-view',    label: '👁️ Pitangus View (Código)' },
      { id: 'pitangus-admin',   label: '⚙️ Pitangus Admin' },
    ];

    const menuEl = document.getElementById('menu');
    const contentEl = document.getElementById('content');
    let selectedIndex = 0;

    // Garante que qualquer canvas criado pelo Pitangus.js fora do container seja limpo ao trocar de aba
    function cleanupOrphanCanvases() {
      document.querySelectorAll('body > canvas').forEach(c => c.remove());
      window.gamemode = null;
    }

    // ============================================================
    // 2. RENDERIZAÇÃO E NAVEGAÇÃO DO MENU
    // ============================================================
    function renderMenu() {
      menuEl.innerHTML = '';
      MENU_ITEMS.forEach((item, index) => {
        const li = document.createElement('li');
        li.textContent = item.label;
        li.dataset.id = item.id;
        li.dataset.index = index;
        if (index === selectedIndex) li.classList.add('selected');

        li.addEventListener('click', () => {
          selectItem(index);
          activateItem(item.id);
        });

        menuEl.appendChild(li);
      });
    }

    function selectItem(index) {
      menuEl.querySelectorAll('li').forEach(li => li.classList.remove('selected'));
      const newLi = menuEl.querySelector(`li[data-index="${index}"]`);
      if (newLi) {
        newLi.classList.add('selected');
        selectedIndex = index;
      }
    }

    function activateItem(id) {
      cleanupOrphanCanvases();
      contentEl.innerHTML = '';
      switch (id) {
        case 'socket-play':      renderSocketPlay(); break;
        case 'socket-io':        renderSocketIO(); break;
        case 'irc-chat':         renderIRCChat(); break;
        case 'stream':           renderStream(); break;
        case 'manual':           renderManual(); break;
        case 'pitangus-request': renderPitangusRequest(); break;
        case 'pitangus-party':   renderPitangusParty(); break;
        case 'pitangus-view':    renderPitangusView(); break;
        case 'pitangus-admin':   renderPitangusAdmin(); break;
        default: contentEl.innerHTML = '<p>Opção desconhecida.</p>';
      }
    }

    document.addEventListener('keydown', (e) => {
      // Evita navegar no menu quando o usuário está digitando em inputs
      if (document.activeElement && ['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        return;
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = (selectedIndex + 1) % MENU_ITEMS.length;
        selectItem(next);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = (selectedIndex - 1 + MENU_ITEMS.length) % MENU_ITEMS.length;
        selectItem(prev);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const item = MENU_ITEMS[selectedIndex];
        if (item) activateItem(item.id);
      }
    });

    // ============================================================
    // 3. ÁUDIO E MODO DE JOGO (INICIALIZADO APENAS APÓS CONEXÃO)
    // ============================================================
    let audioCtx = null;
    function initAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function sfx(type) {
      try {
        initAudio();
        const now = audioCtx.currentTime;
        if (type === 'success') {
          [523, 659, 784, 1047].forEach((f, i) => {
            const o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.connect(g); g.connect(audioCtx.destination);
            o.type = 'sine'; o.frequency.setValueAtTime(f, now + i * 0.1);
            g.gain.setValueAtTime(0.1, now + i * 0.1);
            g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.1 + 0.15);
            o.start(now + i * 0.1); o.stop(now + i * 0.1 + 0.15);
          });
          return;
        }
        const o = audioCtx.createOscillator(), g = audioCtx.createGain();
        o.connect(g); g.connect(audioCtx.destination);
        switch (type) {
          case 'click':
            o.type = 'square'; o.frequency.setValueAtTime(800, now);
            o.frequency.exponentialRampToValueAtTime(600, now + 0.05);
            g.gain.setValueAtTime(0.06, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
            o.start(now); o.stop(now + 0.08); break;
          case 'select':
            o.type = 'sine'; o.frequency.setValueAtTime(520, now);
            o.frequency.exponentialRampToValueAtTime(880, now + 0.1);
            g.gain.setValueAtTime(0.09, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
            o.start(now); o.stop(now + 0.12); break;
          case 'pickup':
            o.type = 'triangle'; o.frequency.setValueAtTime(440, now);
            o.frequency.exponentialRampToValueAtTime(1320, now + 0.15);
            g.gain.setValueAtTime(0.1, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
            o.start(now); o.stop(now + 0.2); break;
          case 'error':
            o.type = 'sawtooth'; o.frequency.setValueAtTime(200, now);
            o.frequency.exponentialRampToValueAtTime(80, now + 0.3);
            g.gain.setValueAtTime(0.12, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
            o.start(now); o.stop(now + 0.35); break;
          case 'bsod':
            o.type = 'sawtooth'; o.frequency.setValueAtTime(120, now);
            o.frequency.exponentialRampToValueAtTime(40, now + 0.8);
            g.gain.setValueAtTime(0.18, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.9);
            o.start(now); o.stop(now + 0.9); break;
        }
      } catch (e) {}
    }

    function startPitangusGame(wrapperEl, containerEl) {
      wrapperEl.classList.add('connected');
      containerEl.innerHTML = '';

      window.gamemode = function(engine, PIXI) {
        // Garante que o canvas fique dentro de #game-container e não solto no body
        if (engine.app && engine.app.canvas && engine.app.canvas.parentElement !== containerEl) {
          containerEl.appendChild(engine.app.canvas);
        }

        const W = engine.app.screen.width;
        const H = engine.app.screen.height;
        engine.Save.init('donetrino_save');

        // ---------------- MENU PRINCIPAL ----------------
        class MenuScene extends engine.Scene {
          create() {
            const bg = new PIXI.Graphics();
            bg.rect(0, 0, W, H).fill(0x0f172a);
            for (let x = 0; x < W; x += 60) bg.moveTo(x, 0).lineTo(x, H).stroke({ width: 1, color: 0x1e293b, alpha: 0.3 });
            for (let y = 0; y < H; y += 60) bg.moveTo(0, y).lineTo(W, y).stroke({ width: 1, color: 0x1e293b, alpha: 0.3 });
            this.container.addChild(bg);

            const title = new PIXI.Text({
              text: 'DONETRINO CASE',
              style: {
                fontFamily: 'Courier New', fontSize: 64, fontWeight: 'bold',
                fill: 0x00e5ff, stroke: 0x004d40, strokeThickness: 4, letterSpacing: 8,
                dropShadow: { color: 0x00e5ff, blur: 20, distance: 0, alpha: 0.5 }
              }
            });
            title.anchor.set(0.5); title.x = W / 2; title.y = 180;
            this.container.addChild(title);

            const sub = new PIXI.Text({
              text: '— INVESTIGAÇÃO CRIMINAL DIGITAL —',
              style: { fontFamily: 'Courier New', fontSize: 18, fill: 0x64748b, letterSpacing: 4 }
            });
            sub.anchor.set(0.5); sub.x = W / 2; sub.y = 240;
            this.container.addChild(sub);

            this.options = ['NEW GAME', 'SAVE GAME', 'OPTIONS'];
            this.selected = 0;
            this.menuTexts = [];
            this.options.forEach((label, i) => {
              const t = new PIXI.Text({
                text: label,
                style: { fontFamily: 'Courier New', fontSize: 32, fill: 0x94a3b8, letterSpacing: 6 }
              });
              t.anchor.set(0.5); t.x = W / 2; t.y = 360 + i * 70;
              t.eventMode = 'static'; t.cursor = 'pointer';
              t.on('pointerover', () => { this.selected = i; this.updateMenu(); });
              t.on('pointerdown', () => { this.confirm(); });
              this.container.addChild(t);
              this.menuTexts.push(t);
            });
            this.updateMenu();

            const footer = new PIXI.Text({
              text: '© 2026 Donetrino Case — Pitangus.js v2.0.0',
              style: { fontFamily: 'Courier New', fontSize: 12, fill: 0x334155 }
            });
            footer.anchor.set(0.5); footer.x = W / 2; footer.y = H - 30;
            this.container.addChild(footer);
          }
          updateMenu() {
            this.menuTexts.forEach((t, i) => {
              const a = i === this.selected;
              t.style.fill = a ? 0x00e5ff : 0x94a3b8;
              t.style.fontSize = a ? 36 : 32;
              t.style.dropShadow = a
                ? { color: 0x00e5ff, blur: 15, distance: 0, alpha: 0.6 }
                : { color: 0x000000, blur: 0, distance: 0, alpha: 0 };
            });
          }
          update() {
            if (engine.Input.pressed('ArrowUp') || engine.Input.pressed('KeyW')) {
              this.selected = (this.selected - 1 + 3) % 3; sfx('click'); this.updateMenu();
            }
            if (engine.Input.pressed('ArrowDown') || engine.Input.pressed('KeyS')) {
              this.selected = (this.selected + 1) % 3; sfx('click'); this.updateMenu();
            }
            if (engine.Input.pressed('Enter') || engine.Input.pressed('Space')) this.confirm();
          }
          confirm() {
            sfx('select');
            if (this.selected === 0) engine.start('level1');
            else if (this.selected === 1) engine.start('save');
            else engine.start('options');
          }
        }

        // ---------------- SAVE GAME ----------------
        class SaveScene extends engine.Scene {
          create() {
            const bg = new PIXI.Graphics();
            bg.rect(0, 0, W, H).fill(0x0f172a);
            this.container.addChild(bg);

            const title = new PIXI.Text({
              text: 'SAVE GAME',
              style: { fontFamily: 'Courier New', fontSize: 48, fontWeight: 'bold', fill: 0x00e5ff, letterSpacing: 6 }
            });
            title.anchor.set(0.5); title.x = W / 2; title.y = 80;
            this.container.addChild(title);

            this.slots = engine.Save.get('slots', Array(8).fill(null));
            if (!Array.isArray(this.slots) || this.slots.length !== 8) this.slots = Array(8).fill(null);
            this.selected = 0;
            this.slotRects = [];
            this.slotTexts = [];

            for (let i = 0; i < 8; i++) {
              const col = i % 2, row = Math.floor(i / 2);
              const x = W / 2 - 300 + col * 320;
              const y = 160 + row * 110;

              const r = new PIXI.Graphics();
              r.roundRect(x, y, 280, 80, 8);
              r.fill(this.slots[i] ? 0x1e293b : 0x0f172a);
              r.stroke({ width: 2, color: 0x334155 });
              r.eventMode = 'static'; r.cursor = 'pointer';
              r.on('pointerdown', () => { this.selected = i; this.refresh(); });
              this.container.addChild(r);
              this.slotRects.push({ g: r, x, y });

              const lbl = new PIXI.Text({
                text: `SLOT ${i + 1}`,
                style: { fontFamily: 'Courier New', fontSize: 16, fill: 0x64748b, fontWeight: 'bold' }
              });
              lbl.x = x + 15; lbl.y = y + 12;
              this.container.addChild(lbl);

              const info = new PIXI.Text({
                text: this.slots[i] ? `Fase 1 — ${this.slots[i].timestamp}` : '— vazio —',
                style: { fontFamily: 'Courier New', fontSize: 13, fill: this.slots[i] ? 0x94a3b8 : 0x475569 }
              });
              info.x = x + 15; info.y = y + 45;
              this.container.addChild(info);
              this.slotTexts.push(info);
            }

            const hint = new PIXI.Text({
              text: 'ENTER: salvar  |  C: carregar  |  ESC: voltar',
              style: { fontFamily: 'Courier New', fontSize: 14, fill: 0x64748b }
            });
            hint.anchor.set(0.5); hint.x = W / 2; hint.y = H - 60;
            this.container.addChild(hint);

            this.refresh();
          }
          refresh() {
            this.slotRects.forEach((s, i) => {
              s.g.clear();
              s.g.roundRect(s.x, s.y, 280, 80, 8);
              s.g.fill(this.slots[i] ? 0x1e293b : 0x0f172a);
              s.g.stroke({ width: i === this.selected ? 3 : 2, color: i === this.selected ? 0x00e5ff : 0x334155 });
            });
          }
          update() {
            if (engine.Input.pressed('ArrowUp') || engine.Input.pressed('KeyW')) { this.selected = (this.selected - 2 + 8) % 8; sfx('click'); this.refresh(); }
            if (engine.Input.pressed('ArrowDown') || engine.Input.pressed('KeyS')) { this.selected = (this.selected + 2) % 8; sfx('click'); this.refresh(); }
            if (engine.Input.pressed('ArrowLeft') || engine.Input.pressed('KeyA')) { this.selected = (this.selected - 1 + 8) % 8; sfx('click'); this.refresh(); }
            if (engine.Input.pressed('ArrowRight') || engine.Input.pressed('KeyD')) { this.selected = (this.selected + 1) % 8; sfx('click'); this.refresh(); }
            if (engine.Input.pressed('Enter')) {
              const now = new Date();
              const ts = `${now.getDate().toString().padStart(2, '0')}/${(now.getMonth() + 1).toString().padStart(2, '0')} ${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
              this.slots[this.selected] = { level: 1, timestamp: ts, data: { phase: 'level1' } };
              engine.Save.set('slots', this.slots);
              this.slotTexts[this.selected].text = `Fase 1 — ${ts}`;
              this.slotTexts[this.selected].style.fill = 0x94a3b8;
              sfx('success'); this.refresh();
            }
            if (engine.Input.pressed('KeyC') && this.slots[this.selected]) { sfx('success'); engine.start('level1'); }
            if (engine.Input.pressed('Escape')) { sfx('select'); engine.start('menu'); }
          }
        }

        // ---------------- OPTIONS ----------------
        class OptionsScene extends engine.Scene {
          create() {
            const bg = new PIXI.Graphics();
            bg.rect(0, 0, W, H).fill(0x0f172a);
            this.container.addChild(bg);
            const title = new PIXI.Text({
              text: 'OPTIONS',
              style: { fontFamily: 'Courier New', fontSize: 48, fontWeight: 'bold', fill: 0x00e5ff, letterSpacing: 6 }
            });
            title.anchor.set(0.5); title.x = W / 2; title.y = 100;
            this.container.addChild(title);
            [
              'Volume Master ............ [ 100% ]',
              'Efeitos Sonoros ........... [ ON  ]',
              'Velocidade do Texto ....... [ NORMAL ]',
              '',
              'Pressione ESC para voltar'
            ].forEach((line, i) => {
              const t = new PIXI.Text({
                text: line,
                style: { fontFamily: 'Courier New', fontSize: 22, fill: 0x94a3b8 }
              });
              t.anchor.set(0.5); t.x = W / 2; t.y = 240 + i * 55;
              this.container.addChild(t);
            });
          }
          update() { if (engine.Input.pressed('Escape')) { sfx('select'); engine.start('menu'); } }
        }

        // ---------------- LEVEL 1 ----------------
        class Level1Scene extends engine.Scene {
          create() {
            this.progress = {
              hdPicked: false, hdConnected: false, pcOn: false,
              explorerOpened: false, dViewed: false, filesSelected: false,
              filesCopied: false, pendrivePicked: false, pendriveInserted: false,
              filesPasted: false, pendriveReturned: false, delivered: false
            };
            this.state = {
              explorerOpen: false, viewingDrive: null,
              pendriveLocation: 'table'
            };
            this.bsodRisk = 0;
            this.bsodActive = false;
            this.osOpen = false;
            this.clipboard = null;
            this.usbFiles = [];
            this.messageTimer = 0;
            this.endingActive = false;
            this.endingIndex = 0;

            this.hdFiles = [
              { name: 'extrato_oculto.pdf', correct: true, selected: false },
              { name: 'logs_acesso.txt', correct: true, selected: false },
              { name: 'planilha_fraude.xlsx', correct: true, selected: false },
              { name: 'nao_clique.exe', correct: false, selected: false },
              { name: 'definitivamente_nao_e_virus.exe', correct: false, selected: false },
              { name: 'backup_corrompido.zip', correct: false, selected: false }
            ];

            this.buildRoom();
            this.buildHUD();
            this.osContainer = new PIXI.Container();
            this.container.addChild(this.osContainer);
            this.buildBSOD();
            this.rebuildOS();
            this.updateHUD();
          }

          buildRoom() {
            const room = new PIXI.Container();
            this.container.addChild(room);
            this.roomContainer = room;

            const wall = new PIXI.Graphics();
            wall.rect(0, 0, W, 450).fill(0x1a1a2e);
            room.addChild(wall);

            const floor = new PIXI.Graphics();
            floor.rect(0, 450, W, H - 450).fill(0x0f172a);
            for (let x = 0; x < W; x += 100) floor.moveTo(x, 450).lineTo(x - 50, H).stroke({ width: 1, color: 0x16213e });
            room.addChild(floor);

            const table = new PIXI.Graphics();
            table.rect(30, 430, 280, 20).fill(0x5c3a21);
            table.rect(40, 450, 15, 90).fill(0x3d2b1f);
            table.rect(285, 450, 15, 90).fill(0x3d2b1f);
            room.addChild(table);

            this.pendriveSprite = new PIXI.Graphics();
            this.pendriveSprite.roundRect(150, 405, 50, 20, 4).fill(0x0066ff);
            this.pendriveSprite.roundRect(195, 410, 12, 10, 2).fill(0xcccccc);
            this.pendriveSprite.eventMode = 'static'; this.pendriveSprite.cursor = 'pointer';
            this.pendriveSprite.on('pointerdown', () => this.clickPendrive());
            room.addChild(this.pendriveSprite);

            this.hdSprite = new PIXI.Graphics();
            this.hdSprite.roundRect(80, 630, 80, 55, 6).fill(0x555555);
            this.hdSprite.roundRect(90, 640, 60, 35, 3).fill(0x333333);
            this.hdSprite.circle(120, 660, 8).fill(0x888888);
