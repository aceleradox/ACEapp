          rebuildOS() {
            this.osContainer.removeChildren().forEach(c => c.destroy({ children: true }));
            if (!this.osOpen) return;

            const ox = 350, oy = 100, ow = 800, oh = 500;

            const bg = new PIXI.Graphics();
            bg.rect(ox, oy, ow, oh).fill(0x0a0a1a);
            bg.stroke({ width: 2, color: 0x00e5ff });
            bg.eventMode = 'static';
            this.osContainer.addChild(bg);

            const tb = new PIXI.Graphics();
            tb.rect(ox, oy, ow, 35).fill(0x0f3460);
            this.osContainer.addChild(tb);

            const titleTxt = new PIXI.Text({ text: '🖥 DonetrinoOS — Análise Forense', style: { fontFamily: 'Courier New', fontSize: 14, fill: 0x00e5ff } });
            titleTxt.x = ox + 15; titleTxt.y = oy + 10;
            this.osContainer.addChild(titleTxt);

            const taskbar = new PIXI.Graphics();
            taskbar.rect(ox, oy + oh - 35, ow, 35).fill(0x0f3460);
            this.osContainer.addChild(taskbar);

            const expBtn = new PIXI.Graphics();
            expBtn.roundRect(ox + 10, oy + oh - 30, 150, 25, 4).fill(this.state.explorerOpen ? 0x00e5ff : 0x1a1a2e);
            expBtn.stroke({ width: 1, color: 0x00e5ff });
            expBtn.eventMode = 'static'; expBtn.cursor = 'pointer';
            expBtn.on('pointerdown', () => {
              this.state.explorerOpen = true;
              this.progress.explorerOpened = true;
              sfx('click'); this.rebuildOS(); this.updateHUD();
            });
            this.osContainer.addChild(expBtn);

            const expBtnTxt = new PIXI.Text({
              text: '📁 File Explorer',
              style: { fontFamily: 'Courier New', fontSize: 12, fill: this.state.explorerOpen ? 0x0a0a1a : 0x00e5ff }
            });
            expBtnTxt.x = ox + 18; expBtnTxt.y = oy + oh - 26;
            this.osContainer.addChild(expBtnTxt);

            const cx = ox, cy = oy + 35, cw = ow, ch = oh - 70;
            if (!this.state.explorerOpen) this.drawDesktop(cx, cy, cw, ch);
            else this.drawExplorer(cx, cy, cw, ch);
          }

          drawDesktop(x, y, w, h) {
            const bg = new PIXI.Graphics();
            bg.rect(x, y, w, h).fill(0x0f172a);
            this.osContainer.addChild(bg);

            const hint = new PIXI.Text({
              text: 'Bem-vindo ao DonetrinoOS\n\nClique no ícone abaixo ou na barra de tarefas\npara abrir o File Explorer.',
              style: { fontFamily: 'Courier New', fontSize: 14, fill: 0x64748b, align: 'center' }
            });
            hint.anchor.set(0.5); hint.x = x + w / 2; hint.y = y + h / 2 - 70;
            this.osContainer.addChild(hint);

            const iconX = x + w / 2 - 40, iconY = y + h / 2 + 10;
            const icon = new PIXI.Graphics();
            icon.roundRect(iconX, iconY, 80, 80, 8).fill(0x1a1a2e);
            icon.stroke({ width: 2, color: 0x00e5ff });
            icon.eventMode = 'static'; icon.cursor = 'pointer';
            icon.on('pointerdown', () => {
              this.state.explorerOpen = true;
              this.progress.explorerOpened = true;
              sfx('click'); this.rebuildOS(); this.updateHUD();
            });
            this.osContainer.addChild(icon);

            const it = new PIXI.Text({ text: '📁', style: { fontSize: 40 } });
            it.x = iconX + 18; it.y = iconY + 10;
            this.osContainer.addChild(it);

            const il = new PIXI.Text({ text: 'Explorer', style: { fontFamily: 'Courier New', fontSize: 11, fill: 0x00e5ff } });
            il.anchor.set(0.5); il.x = iconX + 40; il.y = iconY + 90;
            this.osContainer.addChild(il);
          }

          drawExplorer(x, y, w, h) {
            const bg = new PIXI.Graphics();
            bg.rect(x, y, w, h).fill(0x1a1a2e);
            this.osContainer.addChild(bg);

            const sbW = 180;
            const sb = new PIXI.Graphics();
            sb.rect(x, y, sbW, h).fill(0x0f172a);
            sb.moveTo(x + sbW, y).lineTo(x + sbW, y + h).stroke({ width: 1, color: 0x334155 });
            this.osContainer.addChild(sb);

            const sbH = new PIXI.Text({ text: '📌 Este Computador', style: { fontFamily: 'Courier New', fontSize: 12, fill: 0x00e5ff } });
            sbH.x = x + 10; sbH.y = y + 10;
            this.osContainer.addChild(sbH);

            this.addDriveItem(x + 10, y + 40, sbW - 20, '💾 C: (Sistema)', 'C');
            if (this.progress.hdConnected) this.addDriveItem(x + 10, y + 80, sbW - 20, '💿 D: (HD)', 'D');
            if (this.progress.pendriveInserted && this.state.pendriveLocation === 'pc')
              this.addDriveItem(x + 10, y + 120, sbW - 20, '🔌 E: (PENDRIVE)', 'USB');

            const cx = x + sbW, cy = y, cw = w - sbW, ch = h;

            if (!this.state.viewingDrive) {
              const t = new PIXI.Text({ text: 'Selecione um drive à esquerda', style: { fontFamily: 'Courier New', fontSize: 14, fill: 0x475569 } });
              t.anchor.set(0.5); t.x = cx + cw / 2; t.y = cy + ch / 2;
              this.osContainer.addChild(t);
            } else if (this.state.viewingDrive === 'C') {
              this.drawContent(cx, cy, cw, ch, [
                { name: 'system32', folder: true },
                { name: 'Program Files', folder: true },
                { name: 'Windows', folder: true }
              ], null);
            } else if (this.state.viewingDrive === 'D') {
              this.drawHeader(cx, cy, cw, 'D: — HD Conectado', true, false, false);
              this.drawContent(cx, cy + 50, cw, ch - 50,
                this.hdFiles.map(f => ({
                  name: f.name, isFile: true, selected: f.selected,
                  onClick: () => this.clickFile(f)
                })), null);
            } else if (this.state.viewingDrive === 'USB') {
              this.drawHeader(cx, cy, cw, 'E: — PENDRIVE', false, true, true);
              this.drawContent(cx, cy + 50, cw, ch - 50,
                this.usbFiles.map(f => ({ name: f.name, isFile: true, selected: false, onClick: null })),
                'Drive vazio — use COPIAR no D: e depois COLAR aqui');
            }
          }

          addDriveItem(x, y, w, label, drive) {
            const active = this.state.viewingDrive === drive;
            const g = new PIXI.Graphics();
            g.roundRect(x, y, w, 32, 4).fill(active ? 0x0f3460 : 0x1a1a2e);
            if (active) g.stroke({ width: 1, color: 0x00e5ff });
            g.eventMode = 'static'; g.cursor = 'pointer';
            g.on('pointerdown', () => this.clickDrive(drive));
            this.osContainer.addChild(g);
            const t = new PIXI.Text({ text: label, style: { fontFamily: 'Courier New', fontSize: 12, fill: active ? 0x00e5ff : 0xcbd5e1 } });
            t.x = x + 8; t.y = y + 9;
            this.osContainer.addChild(t);
          }

          drawHeader(x, y, w, title, showCopy, showPaste, showEject) {
            const bg = new PIXI.Graphics();
            bg.rect(x, y, w, 45).fill(0x0f172a);
            bg.moveTo(x, y + 45).lineTo(x + w, y + 45).stroke({ width: 1, color: 0x334155 });
            this.osContainer.addChild(bg);

            const t = new PIXI.Text({ text: title, style: { fontFamily: 'Courier New', fontSize: 14, fill: 0x00e5ff, fontWeight: 'bold' } });
            t.x = x + 15; t.y = y + 14;
            this.osContainer.addChild(t);

            let bx = x + w - 15;
            if (showEject) { bx -= 100; this.makeButton(bx, y + 10, 90, 25, '⏏ Ejetar', 0xef4444, () => this.clickEject()); bx -= 10; }
            if (showPaste) { bx -= 90; this.makeButton(bx, y + 10, 80, 25, '📋 Colar', 0x22c55e, () => this.clickPaste()); bx -= 10; }
            if (showCopy) { bx -= 90; this.makeButton(bx, y + 10, 80, 25, '📄 Copiar', 0x3b82f6, () => this.clickCopy()); }
          }

          makeButton(x, y, w, h, label, color, onClick) {
            const b = new PIXI.Graphics();
            b.roundRect(x, y, w, h, 4).fill(color);
            b.eventMode = 'static'; b.cursor = 'pointer';
            b.on('pointerdown', onClick);
            this.osContainer.addChild(b);
            const t = new PIXI.Text({ text: label, style: { fontFamily: 'Courier New', fontSize: 11, fill: 0xffffff, fontWeight: 'bold' } });
            t.anchor.set(0.5); t.x = x + w / 2; t.y = y + h / 2;
            this.osContainer.addChild(t);
          }

          drawContent(x, y, w, h, items, emptyMsg) {
            const bg = new PIXI.Graphics();
            bg.rect(x, y, w, h).fill(0x0a0a1a);
            this.osContainer.addChild(bg);

            if (items.length === 0) {
              const t = new PIXI.Text({
                text: emptyMsg || 'Pasta vazia',
                style: { fontFamily: 'Courier New', fontSize: 13, fill: 0x475569, align: 'center', wordWrap: true, wordWrapWidth: w - 100 }
              });
              t.anchor.set(0.5); t.x = x + w / 2; t.y = y + h / 2;
              this.osContainer.addChild(t);
              return;
            }

            const pad = 15, iw = 180, ih = 80, cols = 3;
            items.forEach((item, i) => {
              const ix = x + pad + (i % cols) * (iw + pad);
              const iy = y + pad + Math.floor(i / cols) * (ih + pad);

              const g = new PIXI.Graphics();
              g.roundRect(ix, iy, iw, ih, 6).fill(item.selected ? 0x1e40af : 0x1a1a2e);
              g.stroke({ width: item.selected ? 2 : 1, color: item.selected ? 0x00e5ff : 0x334155 });
              if (item.onClick) {
                g.eventMode = 'static'; g.cursor = 'pointer';
                g.on('pointerdown', item.onClick);
              }
              this.osContainer.addChild(g);

              const icon = new PIXI.Text({ text: item.folder ? '📁' : '📄', style: { fontSize: 28 } });
              icon.x = ix + 12; icon.y = iy + 20;
              this.osContainer.addChild(icon);

              const nt = new PIXI.Text({
                text: item.name,
                style: { fontFamily: 'Courier New', fontSize: 11, fill: 0xe2e8f0, wordWrap: true, wordWrapWidth: 120 }
              });
              nt.x = ix + 50; nt.y = iy + 25;
              this.osContainer.addChild(nt);
            });
          }

          clickHD() {
            if (this.progress.hdPicked) return;
            this.progress.hdPicked = true;
            this.hdSprite.visible = false;
            sfx('pickup');
            this.showMessage('HD recolhido do chão.');
            this.updateHUD();
          }

          clickPC() {
            if (!this.progress.hdPicked) { sfx('error'); this.showMessage('Você precisa do HD primeiro.'); return; }
            if (!this.progress.hdConnected) {
              this.progress.hdConnected = true;
              sfx('select');
              this.showMessage('HD conectado ao PC via SATA.');
              this.updateHUD(); this.rebuildOS();
            }
          }

          clickPower() {
            if (!this.progress.hdConnected) { sfx('error'); this.showMessage('Conecte o HD primeiro.'); return; }
            if (this.progress.pcOn) { this.showMessage('O PC já está ligado.'); return; }
            this.progress.pcOn = true;
            this.pcLed.clear(); this.pcLed.circle(1175, 500, 4).fill(0x00ff00);
            this.osOpen = true;
            sfx('success');
            this.showMessage('PC ligado. DonetrinoOS iniciando...');
            this.updateHUD(); this.rebuildOS();
          }

          clickUSB() {
            if (this.state.pendriveLocation !== 'inventory') {
              sfx('error'); this.showMessage('Você precisa pegar o pendrive na mesa primeiro.'); return;
            }
            this.state.pendriveLocation = 'pc';
            this.progress.pendriveInserted = true;
            sfx('select');
            this.showMessage('Pendrive inserido. Drive E: disponível no Explorer.');
            this.updateHUD(); this.rebuildOS();
          }

          clickPendrive() {
            if (this.state.pendriveLocation === 'table_final') { this.showMessage('O pendrive já está na mesa. Entregue ao Delegado.'); return; }
            if (this.state.pendriveLocation !== 'table') return;
            if (!this.progress.filesCopied) { sfx('error'); this.showMessage('Copie os arquivos do HD antes de pegar o pendrive.'); return; }
            this.state.pendriveLocation = 'inventory';
            this.progress.pendrivePicked = true;
            this.pendriveSprite.visible = false;
            sfx('pickup');
            this.showMessage('Pendrive recolhido. Agora insira na porta USB do PC.');
            this.updateHUD();
          }

          clickDelegado() {
            if (this.getObjectiveNumber() !== 12) {
              sfx('error');
              this.showMessage('O Delegado Anesinesio aguarda o pendrive com as evidências.');
              return;
            }
            this.startEnding();
          }

          clickDrive(drive) {
            this.state.viewingDrive = drive;
            if (drive === 'D') this.progress.dViewed = true;
            sfx('click'); this.rebuildOS(); this.updateHUD();
          }

          clickFile(file) {
            if (file.correct) {
              file.selected = !file.selected;
              sfx('click');
              const count = this.hdFiles.filter(f => f.selected).length;
              if (count === 3) this.progress.filesSelected = true;
              this.rebuildOS(); this.updateHUD();
            } else {
              this.bsodRisk = Math.min(100, this.bsodRisk + 25);
              sfx('error');
              this.showMessage('⚠️ ARQUIVO SUSPEITO! +25% de risco de BSOD');
              this.updateHUD();
              if (this.bsodRisk >= 100) this.triggerBSOD();
            }
          }

          clickCopy() {
            const selected = this.hdFiles.filter(f => f.selected);
            if (selected.length !== 3) {
              sfx('error'); this.showMessage('Selecione exatamente 3 arquivos de evidência.'); return;
            }
            this.progress.filesSelected = true;
            this.progress.filesCopied = true;
            this.clipboard = selected.map(f => f.name);
            this.hdFiles.forEach(f => f.selected = false);
            sfx('success');
            this.showMessage('Arquivos copiados! Agora pegue o pendrive na mesa.');
            this.updateHUD(); this.rebuildOS();
          }

          clickPaste() {
            if (!this.clipboard) { sfx('error'); this.showMessage('Nada para colar.'); return; }
            if (this.usbFiles.length > 0) { this.showMessage('O pendrive já contém os arquivos.'); return; }
            this.usbFiles = this.clipboard.map(name => ({ name, correct: true }));
            this.progress.filesPasted = true;
            sfx('success');
            this.showMessage('Arquivos colados no pendrive! Agora ejete com segurança.');
            this.updateHUD(); this.rebuildOS();
          }

          clickEject() {
            if (this.state.pendriveLocation !== 'pc') return;
            if (!this.progress.filesPasted) { this.showMessage('Copie e cole os arquivos antes de ejetar.'); return; }
            this.state.pendriveLocation = 'table_final';
            this.progress.pendriveReturned = true;
            this.clipboard = null;
            this.state.viewingDrive = null;
            this.pendriveSprite.visible = true;
            sfx('success');
            this.showMessage('Pendrive ejetado com segurança e colocado na mesa.');
            this.updateHUD(); this.rebuildOS();
          }

          getObjectiveNumber() {
            const p = this.progress;
            if (!p.hdPicked) return 1;
            if (!p.hdConnected) return 2;
            if (!p.pcOn) return 3;
            if (!p.explorerOpened) return 4;
            if (!p.dViewed) return 5;
            if (!p.filesSelected) return 6;
            if (!p.filesCopied) return 7;
            if (!p.pendrivePicked) return 8;
            if (!p.pendriveInserted) return 9;
            if (!p.filesPasted) return 10;
            if (!p.pendriveReturned) return 11;
            if (!p.delivered) return 12;
            return 13;
          }

          updateHUD() {
            const obj = this.getObjectiveNumber();
            const objs = [
              'Pegue o HD no chão (clique nele)',
              'Conecte o HD ao PC (clique no gabinete)',
              'Ligue o PC (clique no botão power)',
              'Abra o File Explorer no DonetrinoOS',
              'Abra o drive D: (HD) no Explorer',
              'Selecione os 3 arquivos de EVIDÊNCIA (PDF/TXT/XLSX)',
              'Clique em COPIAR',
              'Pegue o pendrive na mesa',
              'Insira o pendrive no PC (clique na porta USB)',
              'Cole os arquivos no drive E: (PENDRIVE)',
              'Ejete o pendrive para colocá-lo na mesa',
              'Entregue o pendrive ao Delegado Anesinesio'
            ];
            if (obj >= 1 && obj <= 12) {
              this.objText.text = `Objetivo ${obj}/12: ${objs[obj - 1]}`;
              this.objProg.text = `${obj - 1} de 12 concluídos`;
            } else {
              this.objText.text = '✓ Todos os objetivos concluídos!';
              this.objProg.text = '12 de 12 concluídos';
            }

            let inv = [];
            if (this.progress.hdPicked && !this.progress.hdConnected) inv.push('HD');
            if (this.state.pendriveLocation === 'inventory') inv.push('Pendrive');
            if (this.clipboard) inv.push('Arquivos (clipboard)');
            this.invText.text = 'Inventário: ' + (inv.length ? inv.join(', ') : 'vazio');

            this.riskFill.clear();
            const rw = 280 * (this.bsodRisk / 100);
            let color = 0x22c55e;
            if (this.bsodRisk > 60) color = 0xef4444;
            else if (this.bsodRisk > 30) color = 0xf59e0b;
            if (rw > 0) this.riskFill.rect(W - 300, 38, rw, 15).fill(color);
            this.riskLbl.text = `Risco BSOD: ${Math.floor(this.bsodRisk)}%`;
          }

          showMessage(msg) {
            this.msgText.text = msg;
            this.messageTimer = 3;
          }

          triggerBSOD() {
            this.bsodActive = true;
            sfx('bsod');
            this.bsodContainer.visible = true;
            this.bsodText.text =
              ':(  O seu PC encontrou um problema e precisa ser reiniciado.\n\n' +
              'STOP CODE: DONETRINO_BSOD_0xDEAD\n\n' +
              'O HD foi corrompido pela pressa ou por arquivos perigosos.\n\n' +
              'A investigação será reiniciada em instantes...';
            setTimeout(() => { engine.start('level1'); }, 4000);
          }

          startEnding() {
            this.endingActive = true;
            this.endingIndex = 0;
            this.progress.delivered = true;
            sfx('success');
            this.showEndingLine();
          }

          showEndingLine() {
            const lines = [
              'OFICIAL CONOR:\n"Delegado Anesinesio, aqui está o pendrive com as evidências do HD. Havia fraude, como suspeitávamos."',
              'DELEGADO ANESINESIO:\n"Excelente trabalho, Conor. Vou encaminhar imediatamente para a perícia. Você está de parabéns."',
              '— FIM DA FASE 1 —\n\nO Caso Donetrino está apenas começando...\n\n(A Fase 2 estará disponível em breve)\n\n(Clique para voltar ao menu)'
            ];
            if (this.endingIndex >= lines.length) { engine.start('menu'); return; }

            if (this.endingContainer) {
              this.container.removeChild(this.endingContainer);
              this.endingContainer.destroy({ children: true });
            }
            this.endingContainer = new PIXI.Container();
            this.container.addChild(this.endingContainer);

            const bg = new PIXI.Graphics();
            bg.rect(0, 0, W, H).fill({ color: 0x000000, alpha: 0.88 });
            bg.eventMode = 'static'; bg.cursor = 'pointer';
            bg.on('pointerdown', () => this.showEndingLine());
            this.endingContainer.addChild(bg);

            const box = new PIXI.Graphics();
            box.roundRect(150, 250, W - 300, 220, 12).fill(0x0f172a);
            box.stroke({ width: 3, color: 0x00e5ff });
            this.endingContainer.addChild(box);

            const txt = new PIXI.Text({
              text: lines[this.endingIndex],
              style: { fontFamily: 'Courier New', fontSize: 18, fill: 0xe2e8f0, wordWrap: true, wordWrapWidth: W - 380, align: 'center', lineHeight: 26 }
            });
            txt.anchor.set(0.5); txt.x = W / 2; txt.y = 360;
            this.endingContainer.addChild(txt);

            this.endingIndex++;
          }

          update(dt) {
            if (this.bsodActive || this.endingActive) return;

            if (this.progress.pcOn && this.progress.hdConnected && !this.progress.delivered) {
              this.bsodRisk = Math.min(100, this.bsodRisk + dt * 1.5);
              if (this.bsodRisk >= 100) { this.triggerBSOD(); return; }
            }

            if (this.messageTimer > 0) {
              this.messageTimer -= dt;
              if (this.messageTimer <= 0) this.msgText.text = '';
            }

            this.updateHUD();
          }
        }

        engine.register('menu', MenuScene);
        engine.register('save', SaveScene);
        engine.register('options', OptionsScene);
        engine.register('level1', Level1Scene);
        engine.start('menu');
      };

      // Dispara o bootstrap do Pitangus.js caso ele aguarde window.onload ou init manual
      if (typeof Pitangus !== 'undefined' && typeof Pitangus.init === 'function') {
        Pitangus.init({ container: containerEl });
      } else {
        window.dispatchEvent(new Event('load'));
      }
    }

