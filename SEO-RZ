<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>NTC - NOTORIETY COINS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root{
  --bg:#0a0a0f;
  --card:#13141f;
  --card2:#0f1017;
  --gold:#FFD700;
  --gold-dark:#b8860b;
  --purple:#8A2BE2;
  --purple2:#6a1bb8;
  --text:#e9e9f5;
  --text2:#a5a7c0;
  --ok:#00ff88;
  --err:#ff4d6d;
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  background-image:
    radial-gradient(800px 400px at 80% -10%,rgba(138,43,226,.25),transparent),
    radial-gradient(600px 400px at 10% 110%,rgba(255,215,0,.15),transparent);
}
header{
  text-align:center;
  padding:32px 16px 20px;
  position:relative;
}
header h1{
  font-weight:800;
  font-size:clamp(28px,6vw,52px);
  letter-spacing:1px;
  background:linear-gradient(90deg,var(--gold),#fff,var(--purple));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  filter:drop-shadow(0 0 18px rgba(255,215,0,.25));
}
header p{
  color:var(--text2);
  margin-top:6px;
  font-size:15px;
  letter-spacing:.5px;
}
main{
  max-width:1300px;
  margin:0 auto;
  padding:16px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(330px,1fr));
  gap:18px;
}
.card{
  background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.01));
  border:1px solid rgba(138,43,226,.25);
  border-radius:20px;
  padding:20px;
  box-shadow:0 0 0 1px rgba(255,215,0,.05) inset,0 10px 40px rgba(0,0,0,.5),0 0 40px rgba(138,43,226,.08);
  backdrop-filter: blur(8px);
  position:relative;
  overflow:hidden;
}
.card::before{
  content:"";
  position:absolute;inset:-1px;
  border-radius:20px;
  padding:1px;
  background:linear-gradient(135deg,rgba(255,215,0,.4),transparent 30%,rgba(138,43,226,.5));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  pointer-events:none;
}
.card h2{
  font-size:18px;
  margin-bottom:14px;
  display:flex;align-items:center;gap:8px;
  color:var(--gold);
  text-transform:uppercase;
  letter-spacing:.8px;
}
label{font-size:13px;color:var(--text2);margin:8px 0 4px;display:block}
input,textarea,select{
  width:100%;
  background:var(--card2);
  border:1px solid rgba(255,255,255,.1);
  color:var(--text);
  padding:11px 12px;
  border-radius:12px;
  font-family:inherit;
  font-size:14px;
  outline:none;
  transition:.2s;
}
input:focus,textarea:focus,select:focus{border-color:var(--purple);box-shadow:0 0 0 3px rgba(138,43,226,.2)}
textarea{min-height:88px;resize:vertical}
.mono{font-family:'JetBrains Mono',monospace;font-size:12.5px}
.btn{
  background:linear-gradient(135deg,var(--purple),var(--purple2));
  color:white;
  border:none;
  padding:10px 14px;
  border-radius:12px;
  font-weight:600;
  cursor:pointer;
  font-size:14px;
  transition:.2s;
  box-shadow:0 4px 16px rgba(138,43,226,.3);
}
.btn:hover{transform:translateY(-1px);box-shadow:0 6px 22px rgba(138,43,226,.4)}
.btn:active{transform:translateY(0)}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#1a1200;box-shadow:0 4px 16px rgba(255,215,0,.25)}
.btn-ghost{background:transparent;border:1px solid rgba(255,255,255,.15);box-shadow:none}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.btns .btn{flex:1 1 auto;min-width:70px}
.btn:disabled{opacity:.5;pointer-events:none}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.canvas-wrap{display:flex;flex-direction:column;align-items:center;gap:12px}
#ntcCanvas{width:240px;height:240px;max-width:80vw;filter:drop-shadow(0 10px 30px rgba(255,215,0,.2));transition:filter .2s}
#map{height:260px;border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,.1);margin-top:8px}
.coords{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px;font-size:12px;color:var(--text2)}
.tag{display:inline-block;background:rgba(255,215,0,.1);border:1px solid rgba(255,215,0,.3);color:var(--gold);padding:4px 8px;border-radius:8px;font-size:11px;margin-top:6px;transition:.2s}
.preview{margin-top:8px;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,.1);display:none}
.preview iframe{width:100%;height:180px;border:0;display:block}
.status{font-size:12px;color:var(--ok);margin-top:8px;min-height:18px}
.full{grid-column:1/-1}
@media(max-width:390px){
  main{padding:12px;gap:14px;grid-template-columns:1fr}
  .card{padding:16px}
  .row{grid-template-columns:1fr}
  .btns .btn{min-width:60px;padding:9px 10px}
}
.leaflet-control-attribution{font-size:10px!important}
.toast{
  position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
  background:#1a1b25;border:1px solid rgba(255,215,0,.4);
  padding:10px 16px;border-radius:12px;font-size:13px;opacity:0;pointer-events:none;
  transition:.3s;z-index:9999
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(-6px)}
</style>
</head>
<body>
<header>
  <h1>NTC - NOTORIETY COINS</h1>
  <p>Gerador de Resenhas SEO + Localização</p>
</header>

<main>
  <!-- SEÇÃO 1 -->
  <section class="card">
    <h2>💰 Contador NTC</h2>
    <div class="canvas-wrap">
      <canvas id="ntcCanvas" width="300" height="300"></canvas>
      <div class="btns">
        <button class="btn" id="roletarBtn" onclick="roletarBet()">🎰 ROLETAR</button>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
        <span class="tag" id="ntcInfo">NTC: 0</span>
        <span class="tag" id="ntcRate" style="border-color:rgba(0,255,136,.3);color:var(--ok);background:rgba(0,255,136,.08)">0.0 NTC/s</span>
      </div>
      <div style="font-size:11px;color:var(--text2);margin-top:6px;text-align:center" id="ledgerInfo">🔐 Ledger: 0 transações criptografadas</div>
    </div>
  </section>

  <!-- SEÇÃO NOVA MINERADORA -->
  <section class="card">
    <h2>⛏️ Mineradora NTC</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px">
      <!-- Motor 1 -->
      <div style="background:var(--card2);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <strong style="font-size:14px">Free Farm</strong>
          <span class="tag" id="status1">Parado</span>
        </div>
        <div style="font-size:12px;color:var(--text2)">1 NTC a cada 10s • 0.1 NTC/s</div>
        <div class="btns" style="margin-top:10px">
          <button class="btn" id="toggle1" onclick="toggleMotor(1)">Ativar</button>
        </div>
        <div style="font-size:11px;margin-top:8px;color:var(--text2)">Farmado: <span id="farm1">0</span> NTC</div>
      </div>
      <!-- Motor 2 -->
      <div style="background:var(--card2);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <strong style="font-size:14px">Turbo</strong>
          <span class="tag" id="status2">Bloqueado</span>
        </div>
        <div style="font-size:12px;color:var(--text2)">1 NTC a cada 3s • 0.33 NTC/s</div>
        <div class="btns" style="margin-top:10px">
          <button class="btn btn-gold" id="toggle2" onclick="toggleMotor(2)">Desbloquear (50 NTC)</button>
        </div>
        <div style="font-size:11px;margin-top:8px;color:var(--text2)">Farmado: <span id="farm2">0</span> NTC</div>
      </div>
      <!-- Motor 3 -->
      <div style="background:var(--card2);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <strong style="font-size:14px">Hyper</strong>
          <span class="tag" id="status3">Bloqueado</span>
        </div>
        <div style="font-size:12px;color:var(--text2)">1 NTC a cada 1s • 1.0 NTC/s</div>
        <div class="btns" style="margin-top:10px">
          <button class="btn btn-gold" id="toggle3" onclick="toggleMotor(3)">Desbloquear (150 NTC)</button>
        </div>
        <div style="font-size:11px;margin-top:8px;color:var(--text2)">Farmado: <span id="farm3">0</span> NTC</div>
      </div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
      <span class="tag" id="prodTotal" style="border-color:rgba(138,43,226,.4);color:var(--purple);background:rgba(138,43,226,.1)">Produção total: 0 NTC</span>
    </div>
  </section>

  <!-- SEÇÃO 2 -->
  <section class="card">
    <h2>✍️ Descreva sua resenha</h2>
    <label>Descrição da vibe</label>
    <textarea id="vibe" placeholder="Ex: rolê insano no baile, luz neon, galera cantando até 4h..."></textarea>
    
    <div class="row">
      <div>
        <label>Tipo de bebidas</label>
        <input id="bebidas" placeholder="whisky, cerveja, caipirinha">
      </div>
      <div>
        <label>Músicas funk</label>
        <input id="funk" placeholder="MC Hariel, MC Ryan SP">
      </div>
    </div>

    <div class="row">
      <div>
        <label>Público</label>
        <select id="publico">
          <option>Só mulheres</option>
          <option>Só amigos</option>
          <option selected>Misto</option>
          <option>Casal</option>
          <option>Família</option>
        </select>
      </div>
      <div>
        <label>Link playlist YouTube Mix</label>
        <input id="playlist" placeholder="https://youtube.com/..." oninput="validarYT()">
      </div>
    </div>
    <div class="preview" id="ytPreview"></div>

    <div class="btns" style="margin-top:14px">
      <button class="btn btn-gold" onclick="gerarJS()">GERAR JAVASCRIPT SEO</button>
      <button class="btn btn-ghost" onclick="copiar('jsCode')">Copiar JS</button>
    </div>
    <label style="margin-top:12px">Código gerado</label>
    <textarea id="jsCode" class="mono" readonly style="min-height:180px"></textarea>
  </section>

  <!-- SEÇÃO 3 -->
  <section class="card">
    <h2>📍 Localização OpenStreetMap</h2>
    <div class="row">
      <input id="busca" placeholder="Pesquisar endereço...">
      <button class="btn" id="pesquisaBtn" onclick="pesquisar()">Pesquisar</button>
    </div>
    <div id="map"></div>
    <div class="coords">
      <div>Lat: <span id="lat">-15.9000</span></div>
      <div>Lon: <span id="lon">-48.0500</span></div>
    </div>
    <div style="font-size:12px;margin-top:6px;color:var(--text2)" id="endereco">Recanto das Emas, DF, Brasil</div>
    <div class="btns">
      <button class="btn btn-ghost" id="gpsBtn" onclick="usarLocal()">Usar minha localização</button>
