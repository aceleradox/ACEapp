window.addEventListener('DOMContentLoaded',()=>{
  desenharMoeda();
  initMapa();
  carregarLista();
  atualizarNTCUI();
  atualizarLedgerUI();
  for(let id in motores){ if(motores[id].ativo && motores[id].liberado){ iniciarMotor(id); } }
  atualizarUI_Motores();
  gerarJS(false);
  
  let debounceTimer;
  const scheduleGerar = ()=>{ clearTimeout(debounceTimer); debounceTimer = setTimeout(()=>gerarJS(false),300); };
  ['vibe','bebidas','funk','publico','playlist'].forEach(id=>{
    const el = document.getElementById(id);
    if(el) el.addEventListener('input', scheduleGerar);
  });

  const ultimo = localStorage.getItem('ntcLast');
  if(ultimo){
    try{ const d=JSON.parse(ultimo);
      document.getElementById('bebidas').value=d.bebidas||'';
      document.getElementById('funk').value=d.funk||'';
      document.getElementById('vibe').value=d.descricao||'';
    }catch(e){}
  }
  setInterval(()=>{ localStorage.setItem('ntcLast', JSON.stringify(coletarDados())); },2000);
});
