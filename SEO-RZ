    <select id="arquivos"></select>
    <div class="btns">
      <button class="btn btn-gold" onclick="salvarFirebase()">Salvar Atual</button>
      <button class="btn" onclick="carregarFirebase()">Carregar</button>
      <button class="btn btn-ghost" onclick="deletarFirebase()">Deletar</button>
      <button class="btn btn-ghost" onclick="exportarJSON()">Exportar JSON</button>
    </div>
    <div class="status" id="statusFb">Salvo localmente (simulação Firebase)</div>
  </section>
</main>

<div class="toast" id="toast"></div>

<script>
// ======== ESTADO GLOBAL ========
let ntc = parseInt(localStorage.getItem('ntcCoins') || '0');
let lat = parseFloat(localStorage.getItem('ntcLat') || '-15.9000');
let lon = parseFloat(localStorage.getItem('ntcLon') || '-48.0500');
let enderecoAtual = localStorage.getItem('ntcEnd') || 'Recanto das Emas, DF, Brasil';
let map, marker;
let angulo = 0, spinVel = 0;

// ======== MOTORES ========
let motores = JSON.parse(localStorage.getItem('ntcMotores')) || {
  1: {liberado:true, ativo:false, taxa:10000, ganho:1, farmado:0, nome:'Free Farm', custo:0},
  2: {liberado:false, ativo:false, taxa:3000, ganho:1, farmado:0, nome:'Turbo', custo:50},
  3: {liberado:false, ativo:false, taxa:1000, ganho:1, farmado:0, nome:'Hyper', custo:150}
};
let intervalos = {};

// ======== CANVAS MOEDA ========
const canvas = document.getElementById('ntcCanvas');
const ctx = canvas.getContext('2d');
function desenharMoeda(){
  ctx.clearRect(0,0,300,300);
  ctx.save();
  ctx.translate(150,150);
  ctx.rotate(angulo*0.1);
  ctx.beginPath(); ctx.arc(0,14,110,0,Math.PI*2); ctx.fillStyle='rgba(0,0,0,.4)'; ctx.fill();
  const grad = ctx.createRadialGradient(-30,-30,20,0,0,120);
  grad.addColorStop(0,'#fff7c2'); grad.addColorStop(0.3,'#FFD700'); grad.addColorStop(0.7,'#b8860b'); grad.addColorStop(1,'#7a5a00');
  ctx.beginPath(); ctx.arc(0,0,115,0,Math.PI*2); ctx.fillStyle=grad; ctx.shadowColor='#FFD700'; ctx.shadowBlur=30; ctx.fill(); ctx.shadowBlur=0;
  ctx.beginPath(); ctx.arc(0,0,115,0,Math.PI*2); ctx.strokeStyle='rgba(255,215,0,.8)'; ctx.lineWidth=4; ctx.stroke();
  ctx.beginPath(); ctx.arc(0,0,100,0,Math.PI*2); ctx.strokeStyle='rgba(0,0,0,.2)'; ctx.lineWidth=2; ctx.stroke();
  ctx.rotate(angulo);
  ctx.beginPath(); ctx.arc(0,0,105, -0.2,0.2); ctx.strokeStyle='rgba(255,255,255,.9)'; ctx.lineWidth=12; ctx.shadowColor='#fff'; ctx.shadowBlur=20; ctx.stroke(); ctx.shadowBlur=0;
  ctx.rotate(-angulo*1.1);
  ctx.fillStyle='#0a0a0f'; ctx.font='bold 56px Inter'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(ntc,0,10);
  ctx.font='700 16px Inter'; ctx.fillStyle='rgba(0,0,0,.6)'; ctx.fillText('NTC',0,-38);
  ctx.restore();
  angulo += 0.008 + spinVel; spinVel *= 0.96;
  requestAnimationFrame(desenharMoeda);
}
function alterarNTC(v,reset=false){
  ntc = reset ? 0 : Math.max(0, ntc + v);
  localStorage.setItem('ntcCoins', ntc);
  atualizarNTCUI();
  gerarJS(false);
}
function criptografarNTC(quantidade, origem){
  const obj = {q: quantidade, o: origem, t: Date.now(), s: ntc, h: ''};
  obj.h = btoa(quantidade + '|' + origem + '|' + Date.now() + '|' + Math.random()).slice(0,16);
  return btoa(JSON.stringify(obj));
}
function atualizarLedgerUI(){
  const ledger = JSON.parse(localStorage.getItem('ntcLedger')||'[]');
  const el = document.getElementById('ledgerInfo');
  if(el) el.textContent = `🔐 Ledger: ${ledger.length} transações criptografadas`;
}
function ganharNTC(quantidade, motivo){
  const entry = criptografarNTC(quantidade, motivo);
  const ledger = JSON.parse(localStorage.getItem('ntcLedger') || '[]');
  ledger.push(entry);
  localStorage.setItem('ntcLedger', JSON.stringify(ledger));
  atualizarLedgerUI();
  alterarNTC(quantidade);
  toast(`+${quantidade} NTC por ${motivo}`);
}
function gastarNTC(quantidade, motivo){
  if(ntc < quantidade){
    toast('NTC insuficiente! Farme mais');
    return false;
  }
  alterarNTC(-quantidade);
  toast(`-${quantidade} NTC - ${motivo}`);
  return true;
}
function atualizarNTCUI(){
  const el = document.getElementById('ntcInfo');
  el.textContent = `NTC: ${ntc}`;
  if(ntc > 10){
    el.style.color='var(--ok)'; el.style.borderColor='rgba(0,255,136,.5)'; el.style.background='rgba(0,255,136,.1)';
  }else if(ntc >=3){
    el.style.color='var(--gold)'; el.style.borderColor='rgba(255,215,0,.4)'; el.style.background='rgba(255,215,0,.1)';
  }else{
    el.style.color='var(--err)'; el.style.borderColor='rgba(255,77,109,.5)'; el.style.background='rgba(255,77,109,.1)';
  }
  atualizarBotoes();
  atualizarUI_Motores();
}
function atualizarBotoes(){
  const rss=document.getElementById('rssBtn'), lua=document.getElementById('luaBtn'), pesq=document.getElementById('pesquisaBtn'), gps=document.getElementById('gpsBtn');
  if(rss){ rss.disabled=ntc<3; rss.style.opacity=ntc<3?'.5':'1'; rss.style.pointerEvents=ntc<3?'none':'auto'; }
  if(lua){ lua.disabled=ntc<3; lua.style.opacity=ntc<3?'.5':'1'; lua.style.pointerEvents=ntc<3?'none':'auto'; }
  if(pesq){ pesq.disabled=ntc<1; pesq.style.opacity=ntc<1?'.5':'1'; pesq.style.pointerEvents=ntc<1?'none':'auto'; }
  if(gps){ gps.disabled=ntc<1; gps.style.opacity=ntc<1?'.5':'1'; gps.style.pointerEvents=ntc<1?'none':'auto'; }
}
function roletarBet(){
  const btn = document.getElementById('roletarBtn');
  if(!btn || btn.disabled) return;
  if(ntc < 2){ toast('Precisa de 2 NTC para apostar'); return; }
  btn.disabled = true;
  const originalToast = window.toast;
  window.toast = ()=>{};
  gastarNTC(2, 'Roleta');
  window.toast = originalToast;
  spinVel = 1.5;
  const spinInterval = setInterval(()=>{ spinVel = 1.2; }, 100);
  setTimeout(()=>{
    clearInterval(spinInterval);
    const ganhou = Math.random() < 0.48;
    const canvas = document.getElementById('ntcCanvas');
    if(ganhou){
      window.toast = ()=>{};
      ganharNTC(5, 'Roleta');
      window.toast = originalToast;
      toast('🎉 GANHOU! +5 NTC');
      canvas.style.filter = 'drop-shadow(0 10px 30px rgba(255,215,0,.2)) drop-shadow(0 0 40px rgba(0,255,136,.8))';
    }else{
      toast('💸 PERDEU -2 NTC');
      canvas.style.filter = 'drop-shadow(0 10px 30px rgba(255,215,0,.2)) drop-shadow(0 0 40px rgba(255,77,109,.8))';
    }
    setTimeout(()=>{ canvas.style.filter = 'drop-shadow(0 10px 30px rgba(255,215,0,.2))'; }, 800);
    btn.disabled = false;
  }, 2000);
}

// ======== MAPA ========
function initMapa(){
  map = L.map('map').setView([lat,lon],14);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{ attribution:'© OpenStreetMap'}).addTo(map);
  marker = L.marker([lat,lon],{draggable:true}).addTo(map);
  marker.on('dragend', e=>{
    const nova = e.target.getLatLng();
    if(!gastarNTC(1,'arrastar')){
      marker.setLatLng([lat,lon]);
      return;
    }
    atualizarPos(nova);
  });
  map.on('click', e=>{
    if(!gastarNTC(1,'mapa')) return;
    marker.setLatLng(e.latlng);
    atualizarPos(e.latlng);
  });
  atualizarLabels();
}
async function atualizarPos(ll){
  lat = ll.lat; lon = ll.lng;
  localStorage.setItem('ntcLat',lat); localStorage.setItem('ntcLon',lon);
  atualizarLabels();
  try{
    const r = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`);
    const j = await r.json();
    enderecoAtual = j.display_name || enderecoAtual;
    localStorage.setItem('ntcEnd',enderecoAtual);
    document.getElementById('endereco').textContent = enderecoAtual;
    gerarJS(false);
  }catch(e){}
}
function atualizarLabels(){
  document.getElementById('lat').textContent = lat.toFixed(6);
  document.getElementById('lon').textContent = lon.toFixed(6);
  document.getElementById('endereco').textContent = enderecoAtual;
}
async function pesquisar(){
  const q = document.getElementById('busca').value;
  if(!q) return;
  if(!gastarNTC(1,'pesquisa')) return;
  try{
    const r = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}&limit=1`);
    const j = await r.json();
    if(j[0]){
      const ll = {lat:parseFloat(j[0].lat), lng:parseFloat(j[0].lon)};
      map.setView(ll,16); marker.setLatLng(ll); atualizarPos(ll);
    }else{toast('Endereço não encontrado')}
  }catch(e){toast('Erro na pesquisa')}
}
function usarLocal(){
  if(!navigator.geolocation) return toast('Geolocalização não suportada');
  if(!gastarNTC(1,'GPS')) return;
  navigator.geolocation.getCurrentPosition(p=>{
    const ll = {lat:p.coords.latitude, lng:p.coords.longitude};
    map.setView(ll,16); marker.setLatLng(ll); atualizarPos(ll);
  },()=>toast('Permissão negada'));
}

// ======== YOUTUBE ========
function validarYT(){
  const url = document.getElementById('playlist').value.trim();
  const box = document.getElementById('ytPreview');
  const re = /(?:youtube\.com|youtu\.be).*?(?:v=|embed\/|shorts\/|list=)([a-zA-Z0-9_-]+)/;
  const m = url.match(re);
  if(m && re.test(url)){
    let src = '';
    if(url.includes('list=')){
      try{
        const id = new URLSearchParams(new URL(url).search).get('list');
        src = `https://www.youtube.com/embed/videoseries?list=${id}`;
      }catch(e){ src = `https://www.youtube.com/embed/${m[1]}`; }
    }else{
      src = `https://www.youtube.com/embed/${m[1]}`;
    }
    box.innerHTML = `<iframe src="${src}" allowfullscreen></iframe>`;
    box.style.display='block';
  }else{
    box.style.display='none'; box.innerHTML='';
  }
  gerarJS(false);
}

// ======== GERADOR JS ========
function coletarDados(){
  return {
    notorietyCoins: ntc,
    bebidas: document.getElementById('bebidas').value,
    funk: document.getElementById('funk').value,
    publico: document.getElementById('publico').value,
    playlist: document.getElementById('playlist').value,
    descricao: document.getElementById('vibe').value,
    localizacao: { lat, lon },
    timestamp: new Date().toISOString()
  };
}
function gerarJS(mostrarToast=true){
  const d = coletarDados();
  const codigo = `// SEO Review NTC v1
const ntcReview = {
  notorietyCoins: ${d.notorietyCoins},
  bebidas: "${d.bebidas.replace(/"/g,"'")}",
  funk: "${d.funk.replace(/"/g,"'")}",
  publico: "${d.publico}",
  playlist: "${d.playlist}",
  descricao: "${d.descricao.replace(/\n/g,' ').replace(/"/g,"'")}",
  localizacao: { lat: ${d.localizacao.lat}, lon: ${d.localizacao.lon} },
  timestamp: "${d.timestamp}"
};
document.head.insertAdjacentHTML('beforeend', '<script type="application/ld+json">' + JSON.stringify(ntcReview) + '<\\/script>');`;
  document.getElementById('jsCode').value = codigo;
  if(mostrarToast) toast('JS SEO gerado!');
  return codigo;
}

// ======== SAÍDA ========
function gerarSaida(tipo){
  const d = coletarDados();
  let out = '';
  if(tipo==='js'){
    let js = document.getElementById('jsCode').value;
    if(!js.trim()){ js = gerarJS(true); }
    out = js;
  }else if(tipo==='rss'){
    if(!gastarNTC(3,'RSS')) return;
    out = `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:ntc="https://ntc.notoriety">
<channel>
  <title>NTC - Notoriety Coins Review</title>
  <link>${d.playlist}</link>
  <description>Resenha SEO gerada pelo Sistema NTC</description>
  <language>pt-BR</language>
  <lastBuildDate>${new Date().toUTCString()}</lastBuildDate>
  <item>
    <title>Resenha ${d.publico} - ${d.bebidas||'Vibe'}</title>
    <description><![CDATA[${d.descricao} | Funk: ${d.funk} | Bebidas: ${d.bebidas}]]></description>
    <pubDate>${new Date().toUTCString()}</pubDate>
    <guid isPermaLink="false">ntc-${Date.now()}</guid>
    <ntc:coins>${d.notorietyCoins}</ntc:coins>
    <ntc:localizacao>${d.localizacao.lat},${d.localizacao.lon}</ntc:localizacao>
    <ntc:endereco><![CDATA[${enderecoAtual}]]></ntc:endereco>
  </item>
</channel>
</rss>`;
  }else if(tipo==='lua'){
    if(!gastarNTC(3,'Lua')) return;
    out = `ntc_add({coins=${d.notorietyCoins}, bebidas="${d.bebidas}", funk="${d.funk}", publico="${d.publico}", playlist="${d.playlist}", descricao="${d.descricao.replace(/"/g,"'")}", lat=${d.localizacao.lat}, lon=${d.localizacao.lon}, timestamp="${d.timestamp}"})`;
  }
  document.getElementById('saida').value = out;
  toast('Gerado: '+tipo.toUpperCase());
}

function copiar(id){
  const el = document.getElementById(id);
  el.select(); document.execCommand('copy');
  navigator.clipboard?.writeText(el.value);
  toast('Copiado!');
}
function download(id,nome){
  const blob = new Blob([document.getElementById(id).value],{type:'text/plain'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = nome; a.click();
  URL.revokeObjectURL(a.href);
}

// ======== MINERAÇÃO ========
function salvarMotores(){ localStorage.setItem('ntcMotores', JSON.stringify(motores)); }
function calcularNTCs(){
  let total=0;
  for(let id in motores){
    const m=motores[id];
    if(m.ativo && m.liberado){ total += m.ganho / (m.taxa/1000); }
  }
  return total;
}
function atualizarUI_Motores(){
  const rate = calcularNTCs();
  document.getElementById('ntcRate').textContent = rate.toFixed(1)+' NTC/s';
  let totalFarm=0;
  for(let i=1;i<=3;i++){
    const m=motores[i]; totalFarm+=m.farmado||0;
    const statusEl=document.getElementById('status'+i);
    const btn=document.getElementById('toggle'+i);
    const farmEl=document.getElementById('farm'+i);
    if(!m.liberado){
      statusEl.textContent='Bloqueado'; statusEl.style.color='var(--err)'; statusEl.style.background='rgba(255,77,109,.15)'; statusEl.style.borderColor='rgba(255,77,109,.3)';
      btn.textContent=`Desbloquear (${m.custo} NTC)`; btn.disabled=ntc<m.custo; btn.style.opacity=ntc<m.custo?'.5':'1';
    }else{
      if(m.ativo){
        statusEl.textContent='Ativo'; statusEl.style.color='var(--ok)'; statusEl.style.background='rgba(0,255,136,.15)'; statusEl.style.borderColor='rgba(0,255,136,.3)'; btn.textContent='Desativar';
      }else{
        statusEl.textContent='Parado'; statusEl.style.color='var(--gold)'; statusEl.style.background='rgba(255,215,0,.1)'; statusEl.style.borderColor='rgba(255,215,0,.3)'; btn.textContent='Ativar';
      }
      btn.disabled=false; btn.style.opacity='1';
    }
    farmEl.textContent=m.farmado||0;
  }
  document.getElementById('prodTotal').textContent=`Produção total: ${totalFarm} NTC`;
}
function toggleMotor(id){
  const m=motores[id];
  if(!m.liberado){
    if(!gastarNTC(m.custo, `Desbloquear ${m.nome}`)) return;
    m.liberado=true;
    toast(`${m.nome} liberado!`);
  }
  if(m.ativo){ pararMotor(id); } else { iniciarMotor(id); }
  salvarMotores(); atualizarUI_Motores();
}
function iniciarMotor(id){
  const m=motores[id]; m.ativo=true;
  intervalos[id]=setInterval(()=>{
    ganharNTC(m.ganho, m.nome);
    m.farmado=(m.farmado||0)+m.ganho;
    salvarMotores(); atualizarUI_Motores();
  }, m.taxa);
}
function pararMotor(id){ motores[id].ativo=false; clearInterval(intervalos[id]); }

// ======== FIREBASE SIMULADO ========
function carregarLista(){
  const lista = JSON.parse(localStorage.getItem('ntc_saves')||'[]');
  const sel = document.getElementById('arquivos');
  sel.innerHTML = lista.map((x,i)=>`<option value="${i}">${x.nome}</option>`).join('') || '<option>Nenhum salvo</option>';
}
function salvarFirebase(){
  const lista = JSON.parse(localStorage.getItem('ntc_saves')||'[]');
  const dados = coletarDados(); dados.endereco = enderecoAtual;
  const ledger = JSON.parse(localStorage.getItem('ntcLedger')||'[]');
  dados.ledgerCripto = ledger;
  const nome = `Resenha ${new Date().toLocaleString('pt-BR')}`;
  lista.unshift({nome, dados, id:Date.now()});
  localStorage.setItem('ntc_saves', JSON.stringify(lista.slice(0,50)));
  carregarLista();
  document.getElementById('statusFb').textContent = `NTC criptografado e salvo - ${ledger.length} transações - ${nome}`;
  toast('Salvo!');
}
function carregarFirebase(){
  const lista = JSON.parse(localStorage.getItem('ntc_saves')||'[]');
  const idx = document.getElementById('arquivos').value;
  if(!lista[idx]) return;
  const d = lista[idx].dados;
  ntc = d.notorietyCoins; localStorage.setItem('ntcCoins',ntc);
  document.getElementById('bebidas').value = d.bebidas||'';
  document.getElementById('funk').value = d.funk||'';
  document.getElementById('publico').value = d.publico||'Misto';
  document.getElementById('playlist').value = d.playlist||'';
  document.getElementById('vibe').value = d.descricao||'';
  lat = d.localizacao.lat; lon = d.localizacao.lon;
  enderecoAtual = d.endereco||enderecoAtual;
  map.setView([lat,lon],15); marker.setLatLng([lat,lon]); atualizarLabels();
  atualizarNTCUI(); validarYT(); gerarJS(false); toast('Carregado!');
}
function deletarFirebase(){
  let lista = JSON.parse(localStorage.getItem('ntc_saves')||'[]');
  const idx = document.getElementById('arquivos').value;
  lista.splice(idx,1);
  localStorage.setItem('ntc_saves', JSON.stringify(lista));
  carregarLista(); toast('Deletado');
}
function exportarJSON(){
  const data = localStorage.getItem('ntc_saves')||'[]';
  downloadText('ntc-backup.json', data);
}
function downloadText(name,txt){
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([txt],{type:'application/json'}));
  a.download=name;a.click();
}

// ======== UTILS ========
function toast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2000);
}

