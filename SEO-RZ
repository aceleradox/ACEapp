  <!-- SEÇÃO 4 -->
  <section class="card full">
    <h2>🚀 Gerar Saída</h2>
    <div class="btns">
      <button class="btn btn-gold" onclick="gerarSaida('js')">Gerar JavaScript Completo</button>
      <button class="btn" id="rssBtn" onclick="gerarSaida('rss')">Gerar RSS</button>
      <button class="btn" id="luaBtn" onclick="gerarSaida('lua')">Gerar Comando Lua</button>
    </div>
    <textarea id="saida" class="mono" readonly style="min-height:220px;margin-top:12px"></textarea>
    <div class="btns">
      <button class="btn btn-ghost" onclick="copiar('saida')">Copiar</button>
      <button class="btn btn-ghost" onclick="download('saida','ntc-review.js')">Download .js</button>
      <button class="btn btn-ghost" onclick="download('saida','ntc-review.xml')">Download .xml</button>
      <button class="btn btn-ghost" onclick="download('saida','ntc-review.lua')">Download .lua</button>
    </div>
  </section>

  <!-- SEÇÃO 5 -->
  <section class="card full">
    <h2>☁️ Salvar na Nuvem (Simulado)</h2>
